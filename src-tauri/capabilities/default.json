{
  "identifier": "default",
  "description": "Default permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/**/*"]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "https://**/**" },
        { "url": "http://**" },
        { "url": "http://localhost:**" },
        { "url": "http://localhost:**/**" },
        { "url": "http://127.0.0.1:**" },
        { "url": "http://127.0.0.1:**/**" }
      ]
    },
    "core:event:default"
  ]
}
